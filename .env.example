# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=

# Hugging Face (huggingface.co/settings/tokens) — для публикации модели и датасета
HF_TOKEN=

# Kaggle (kaggle.com/settings → Create New Token) — для скачивания датасетов
KAGGLE_USERNAME=
KAGGLE_KEY=

# Локальные сервисы
OLLAMA_HOST=http://localhost:11434
# Qdrant работает встроенно (файлы в QDRANT_PATH), сервер и Docker не нужны.
# На сервере вместо этого задаётся QDRANT_URL.
QDRANT_PATH=data/qdrant
QDRANT_URL=
QDRANT_COLLECTION=memes

# Пути
DATA_DIR=data

# Поиск в боте: модель эмбеддингов (имя на HF или путь к дообученной в models/) и устройство
SEARCH_MODEL=deepvk/USER-bge-m3
SEARCH_DEVICE=
# Соль для хеширования user_id в логах (любая случайная строка)
BOT_USER_SALT=
